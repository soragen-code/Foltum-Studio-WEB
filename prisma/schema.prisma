generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  credits       Int       @default(100)
  subscriptionTier String? @default("free")
  subscriptionExpiresAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  projects      Project[]
  creditTransactions CreditTransaction[]
  payments      Payment[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  name        String
  tier        String   @default("minimum") // minimum, medium, maximum
  stage       String   @default("synopsis") // legacy: synopsis, characters, structure, scenes | new flow: idea, references, structure, scenes
  // New flow (stage 1): power tier LOW/MEDIUM/HIGH — see lib/power-tier.ts. `tier` is kept in sync for legacy paths.
  powerTier   String   @default("MEDIUM")
  // Auto-detected language of the idea/synopsis (ISO 639-1, e.g. "ru", "en").
  language    String   @default("en")
  idea        String?  @db.Text
  // New flow (Stage 14 B): producer-chosen number of episodes for the season. Null = let the AI decide.
  episodeCount Int?
  synopsis    String?  @db.Text
  synopsisApproved Boolean @default(false)
  // Stage 46A: approved SHORT synopsis (JSON {premise, episodes[{number, logline}]}) — mandatory outline for the season structure.
  shortSynopsis String? @db.Text
  charactersApproved Boolean @default(false)
  charactersLocked Boolean @default(false)
  structureApproved Boolean @default(false)
  isTest      Boolean  @default(false) // stage 40: «Тестовая серия» — a one-scene sandbox project (no season structure, references optional)
  // Stage 59: durable "new 4-step flow" marker. New projects set it true; legacy rows stay false (classic flow).
  // The wizard needs this because at stage=synopsis/early-structure charactersApproved is still false.
  newFlow     Boolean  @default(false)
  // Stage 104: the only media provider is WaveSpeed (columns kept for compatibility, always "wavespeed")
  imageProvider String @default("wavespeed")
  videoProvider String @default("wavespeed")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  characters  Character[]
  locations   Location[]
  artifacts   Artifact[]
  seasons     Season[]

  @@index([userId])
}

model Character {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String?  @db.Text
  role        String?
  personality String?  @db.Text
  appearance  String?  @db.Text
  promptOverride String? @db.Text // stage 46E: manual character prompt — when non-empty it replaces the appearance base for ALL reference shots; null = auto
  age         String?  // free-form ("34", "около 40")
  gender      String?  // Stage 125: "male" | "female" — single source of truth for the character's sex (scenario + reference generation); forces sex/age in the reference prompt so a role like "мать" never renders as a man. null = unknown (fallback heuristic from role/appearance)
  firstAppearance String? @db.Text // where/how the character first appears in the season
  status      String   @default("draft") // draft, approved, references_ready
  imageFront  String?  // cloud_storage_path or placeholder url
  imageProfile String? // cloud_storage_path or placeholder url
  imageFull   String?  // cloud_storage_path or placeholder url
  imageExtra  String?  @db.Text // Stage 14 (E): JSON array of extra character angles (3/4 view, action pose) → 5 photos total
  imageFrontIsPublic  Boolean @default(true)
  imageProfileIsPublic Boolean @default(true)
  imageFullIsPublic   Boolean @default(true)
  isLocked    Boolean  @default(false)
  refLocked   Boolean  @default(false) // Stage 22: reference finalized ("save forever" or after one prompt edit) — no further edits allowed
  userRefs    String?  @db.Text // Stage 75: user-uploaded photo references (JSON array of public S3 URLs, max 4) fed as image_input to every character reference generation
  // Stage 3 (extended cast): MAIN / SUPPORTING / MINOR / CROWD; groupSize only for CROWD groups.
  tier        String   @default("MAIN")
  groupSize   Int?
  prevSnapshot Json?   // stage 60: one previous version for one-step undo
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenes      SceneCharacter[]
  episodes    EpisodeCharacter[]

  @@index([projectId])
}

model Season {
  id          String   @id @default(cuid())
  projectId   String
  number      Int
  title       String?
  logline     String?  @db.Text // stage 2: season arc summary
  fullStory   String?  @db.Text // stage 12: whole detailed season story with explicit episode markers (canon for the whole season)
  status      String   @default("draft") // draft, approved
  premise     String?  @db.Text // stage 46C: season synopsis / short-synopsis JSON for seasons > 1
  previousSeasonId String? // stage 46C: the season this one continues
  episodeCount Int?    // stage 46C: planned episode count
  direction   String?  @db.Text // stage 46C: author's comment for this season
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  episodes    Episode[]

  @@index([projectId])
}

model Episode {
  id            String   @id @default(cuid())
  seasonId      String
  number        Int
  title         String
  description   String?  @db.Text
  cliffhanger   String?  @db.Text
  // Stage 2 fields (additive): logline, location, full script text, status.
  logline       String?  @db.Text
  locationName  String?
  locationDesc  String?  @db.Text
  locationId    String?  // stage 3: bound project Location (reference image)
  script        String?  @db.Text
  arcRole       String?  // stage 2: завязка / развитие / поворот / финал
  status        String   @default("draft") // draft, script_ready, scenes_ready, approved, assembled
  videoUrl      String?  // assembled episode video URL
  videoIsPublic Boolean  @default(false)
  assembleQuality String? // Stage 46B: production quality of the last assembly ("480p" | "720p" | "1080p")
  assembleFps   Int?     // Stage 46B: frame rate of the last assembly (30 | 60)
  chainMode     String   @default("chain") // stage 40 / stage 98: scene generation order — "chain" (DEFAULT since stage 98: one after another, the actual last frame is described and fed to the next scene) | "parallel" (all at once, scripted end-state hand-off). Existing rows keep their stored value.
  chainRunActive Boolean @default(false) // stage 40: a «Сгенерировать все» chain run is in progress — the worker starts the next pending scene after each finished one
  chainRunNote  String?  @db.Text // stage 40: why the last chain run stopped («Цепочка остановлена на сцене N: …»), null while running / after a clean finish
  propRegistry  String?  @db.Text // stage 54: cached JSON snapshot of the episode PROP REGISTRY ({hash, props:[{id,name,description}]}) — auto-extracted from the script, re-built when the hash changes, substituted VERBATIM into each scene's CLOTHING & PROPS section. DATA cache, not a behaviour toggle.
  // Stage 127: production mode chosen AFTER the story is built.
  //   null / "SCENES"  = classic 9-scene pipeline (reangle/region-plate continuity, text-to-video, keyframe/i2v BAN in force).
  //   "STORYBOARD"     = 12-15 keyframe boards; each board frame is a 9:16 still animated into a 3-6s clip via image-to-video,
  //                      clips stitched into one ~90s cut. The keyframe/i2v ban is LIFTED only for this mode.
  // Legacy rows have null → treated as SCENES (fallback), so existing episodes are unaffected.
  mode          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  season        Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  location      Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  scenes        Scene[]
  characters    EpisodeCharacter[]
  artifacts     EpisodeArtifact[]
  boards        Board[]

  @@index([seasonId])
}

/// Stage 127: a single keyframe board of a STORYBOARD-mode episode. Each board is ONE shot change —
/// one action beat OR one pair of dialogue lines. Its frame is a 9:16 reference still (Seedream) that is
/// animated into a 3-6s clip via image-to-video (the board frame is the clip START frame). 12-15 boards
/// per episode, stitched into one ~90s cut. Only used when Episode.mode = "STORYBOARD".
model Board {
  id               String   @id @default(cuid())
  episodeId        String
  index            Int      // 0-based board order within the episode
  actionOrDialogue String   @db.Text // the single action beat OR the dialogue pair this board depicts (story language)
  motionEn         String?  @db.Text // English image-to-video MOTION prompt (what moves during the 3-6s animation)
  // Stage 131: bind the board to its location ZONE so every board of a location shares one geometry authority
  // (master/region plate), the same stabilization SCENES uses (Stage 122). All nullable / additive; legacy
  // boards (null) fall back to the episode Location master plate. STORYBOARD only — SCENES is untouched.
  region           String?  @db.Text // project-language zone/corner of the location this board plays in (reuse identical wording for the same corner)
  regionKey        String?  // normalized cache key of `region` (deriveRegionKey) — resolves a cached region plate when one exists
  plateUrl         String?  // the geometry-authority plate actually attached to this board's frame (region plate, else location master)
  directionJson    String?  @db.Text // Stage 132: validated Storyboard-only speech ledger, camera mode and dialogue shot plan; null for legacy boards
  imagePrompt      String?  @db.Text // English Seedream FRAME prompt used to render the board still (9:16)
  imageUrl         String?  // S3 URL of the rendered board frame (9:16) — the clip's START frame
  videoUrl         String?  // S3 URL of the animated 3-6s clip (image-to-video)
  durationSec      Int?     // planned clip length in seconds (clamped to the i2v-supported 4-6s window)
  status           String   @default("pending") // pending | frame_generating | frame_ready | animating | done | error
  error            String?  @db.Text // last frame/animation error
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  episode          Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([episodeId, index])
  @@index([episodeId])
}

/// Stage 3: key locations of a project — photoreal reference images used by Seedance alongside characters.
model Location {
  id           String   @id @default(cuid())
  projectId    String
  name         String
  description  String?  @db.Text // project-language description shown in UI
  visualPrompt String?  @db.Text // English visual prompt for the reference image (no people)
  visualPromptAuto String? @db.Text // stage 46E: the LLM-written visual prompt as first produced — «reset to auto» restores it; null for legacy rows
  setInventory     String? @db.Text // stage 113: full physical set inventory ("object — placement" per line) written at idea stage; null for legacy rows
  regionPlates String?  @db.Text // stage 122: JSON cache { regionKey: plateUrl } — pre-generated region plates (Seedream edits of the master layout) reused across scenes in the same region of this location; null for legacy rows
  imageUrl     String?  // PNG reference — wide establishing angle
  imageReverse String?  // same place, reverse angle (generated from imageUrl as reference → identical light)
  imageDetail  String?  // same place, medium/detail angle
  imageExtra   String?  @db.Text // JSON array of extra angle/shot URLs generated on demand
  refLocked    Boolean  @default(false) // Stage 22: reference finalized ("save forever" or after one prompt edit) — no further edits allowed
  detailLevel  String?  // LLM-set required visual detail level: "low" | "medium" | "high" → number of reference frames (4/6/9); null = legacy (heuristic fallback)
  prevSnapshot Json?    // stage 60: one previous version for one-step undo
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  episodes     Episode[]

  @@index([projectId])
}

/// Stage 2: which characters take part in an episode (additive join table).
model EpisodeCharacter {
  id          String   @id @default(cuid())
  episodeId   String
  characterId String
  createdAt   DateTime @default(now())

  episode     Episode   @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([episodeId, characterId])
  @@index([characterId])
}

/// Stage 14 (E): important objects / props used in the story — photoreal reference frames
/// (2 per artifact) that Seedance keeps consistent across shots. Project-scoped, bound to
/// the episodes that use them via EpisodeArtifact.
model Artifact {
  id           String   @id @default(cuid())
  projectId    String
  name         String
  description  String?  @db.Text // project-language description shown in UI
  visualPrompt String?  @db.Text // English visual prompt for the reference frames (object only)
  imageUrl     String?  // primary frame
  imageExtra   String?  @db.Text // JSON array of the remaining frame URLs (→ 2 frames total with imageUrl)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  episodes     EpisodeArtifact[]

  @@index([projectId])
}

/// Stage 14 (E): which artifacts appear in an episode (additive join table).
model EpisodeArtifact {
  id          String   @id @default(cuid())
  episodeId   String
  artifactId  String
  createdAt   DateTime @default(now())

  episode     Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  artifact    Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@unique([episodeId, artifactId])
  @@index([artifactId])
}

model Scene {
  id            String   @id @default(cuid())
  episodeId     String
  number        Int
  dialogue      String?  @db.Text
  dialogueEn    String?  @db.Text // stage 4: English lines actually spoken by Seedance (dialogue = story-language text for UI/subtitles)
  subtitled     Boolean  @default(false) // stage 4: subtitles already burned into videoUrl
  locationDesc  String?  @db.Text
  videoPrompt   String?  @db.Text
  videoUrl      String?  // generated scene video URL (Seedance native audio)
  audioUrl      String?  // legacy separate audio for the scene dialogue
  lastFrameUrl  String?  // last frame of this scene's video (S3) — fed as first-frame of the next scene for one-take continuity
  videoIsPublic Boolean  @default(false)
  language      String   @default("en") // spoken language for native audio: "en" or "ru"
  shotType      String?  // stage 2: shot type label from the season script
  action        String?  @db.Text // stage 2: readable action description of the shot
  durationSec   Int?     // stage 2: planned duration (10–15s)
  presence      String?  @db.Text // stage 11: continuity — who is present and where at the START of the scene (follows from the previous scene)
  entrances     String?  @db.Text // stage 11: continuity — who enters/leaves inside the scene and how (shown on screen)
  continuesFrom String?  // stage 11: continuity link to the previous scene: same-location-continuation | character-moves | location-change | new-sequence
  sceneKind     String?  @default("dialogue") // stage 12: "narration" = off-screen voice-over scene (b-roll), "dialogue"/null = normal on-camera scene
  voiceover     String?  @db.Text // stage 12: ENGLISH off-screen narration voiced by the model (backstory/catch-up), used only for narration scenes
  voiceoverLocal String? @db.Text // stage 12: the same narration translated into the story language for the UI
  status        String   @default("pending") // pending, generating, generated, accepted
  videoModel    String?  // chosen video model / provider for this scene: always "seedance" (Seedance 2.5; Stage 63 removed the alternative model option) — persisted per generated scene
  promptOverride String? @db.Text // stage 31: manual per-scene final-prompt override — when non-empty it replaces the auto-assembled prompt TEXT verbatim (image/reference chaining is unaffected); null = use auto prompt
  skipReferences Boolean @default(false) // stage 33/36: submit this scene WITHOUT any reference images (text-only), previous-scene frame included
  skipPreviousFrame Boolean @default(false) // stage 37: keep character/location references but do NOT send the previous scene's last frame (moderation trigger)
  startState    String?  @db.Text // stage 41: SCRIPTED start state of the scene's FIRST frame (English, from the screenwriter) — equals the previous scene's endState unless the scene starts a new sequence; opens the prompt as OPENING STATE
  endState      String?  @db.Text // stage 40: SCRIPTED end state of the scene's final frame (English, from the screenwriter) — the next scene's OPENING STATE in parallel mode
  endStateActual String? @db.Text // stage 40: ACTUAL end state described by a vision model from the generated last frame (chain mode) — wins over endState for the next scene
  lookCache     String?  @db.Text // stage 46B-1: JSON {hash, videoPrompt, startState, endState, openingState} — scene text rewritten to the CURRENT character look
  lookStale     Boolean  @default(false) // stage 46B-1: a linked character's appearance changed after this scene's video was rendered
  prevSnapshot  Json?    // stage 60: one previous version for one-step undo
  // Stage 104: keyframe-driven scenes — a Seedream still (opening frame of the shot) that seeds Seedance image-to-video
  keyframeUrl    String?          // S3 URL of the generated keyframe (9:16 jpeg)
  keyframePrompt String? @db.Text // exact Seedream edit prompt used for the keyframe (shown in the Scene Script modal)
  keyframeStatus String?          // pending | running | done | error
  keyframeError  String? @db.Text // last keyframe error (also set when the video fell back to text-to-video)
  // Stage 122: scene region plate — a pre-generated environment plate (Seedream edit of the master layout) of the
  // exact part of the location this scene happens in, sent as the PRIMARY geometry/background reference into the
  // scene's video clips. NOT a keyframe (no imposed start pose, never a first frame); the last-frame re-angle is
  // kept only for people/motion continuity. Null for legacy scenes → they fall back to the master plates (no auto-migration).
  regionKey      String?          // normalized cache key of the region (locationId + regionKey → shared plate)
  regionDesc     String? @db.Text // English description of WHICH part / vantage of the location this scene occupies (drives the plate edit)
  regionPlateUrl String?          // S3 URL of the pre-generated region plate for this scene
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  episode       Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  characters    SceneCharacter[]

  @@index([episodeId])
}

model SceneCharacter {
  id          String    @id @default(cuid())
  sceneId     String
  characterId String

  scene       Scene     @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([sceneId, characterId])
}

model CreditTransaction {
  id          String   @id @default(cuid())
  userId      String
  amount      Int      // positive = added, negative = spent
  description String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Payment {
  id             String   @id @default(cuid())
  orderReference String   @unique
  userId         String
  productId      String   // plan or credit-pack id
  productName    String
  amount         Float    // charged amount (UAH)
  currency       String   @default("UAH")
  credits        Int      // credits to grant on success
  kind           String   // "subscription" | "credits"
  tier           String?  // subscription tier when kind = subscription
  status         String   @default("pending") // pending, approved, declined, refunded, expired
  transactionStatus String?
  reasonCode     String?
  processed      Boolean  @default(false) // credits already granted (idempotency)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Background generation job (characters / video). Frontend polls GET /api/jobs/[id].
model GenerationJob {
  id          String   @id @default(cuid())
  type        String   // "characters" | "video" | "image"
  status      String   @default("pending") // "pending" | "processing" | "completed" | "failed"
  progress    Int      @default(0) // 0-100
  message     String?  // current step description
  projectId   String
  characterId String?  // for character jobs
  sceneId     String?  // for video/scene jobs
  resultData  String?  @db.Text // JSON string
  error       String?  @db.Text
  cancelRequested Boolean @default(false) // stage 11: author asked to stop — workers check it and mark the job "canceled"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId, status])
  @@index([sceneId])
}
