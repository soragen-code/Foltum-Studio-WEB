generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  credits       Int       @default(0)
  locale        String    @default("ru")
  subscriptionTier String? @default("free")
  subscriptionExpiresAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  projects      Project[]
  creditTransactions CreditTransaction[]
  payments      Payment[]
  manualGenerations ManualGeneration[]
  manualLocations ManualLocation[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  name        String
  tier        String   @default("minimum") // minimum, medium, maximum
  stage       String   @default("synopsis") // legacy: synopsis, characters, structure, scenes | new flow: idea, references, structure, scenes
  // New flow (stage 1): power tier LOW/MEDIUM/HIGH — see lib/power-tier.ts. `tier` is kept in sync for legacy paths.
  powerTier   String   @default("MEDIUM")
  // Auto-detected language of the idea/synopsis (ISO 639-1, e.g. "ru", "en").
  language    String   @default("en")
  // Stage 8 (final): project-level DIALOGUE language (ISO 639-1). Default "en" — dialogue, character
  // names and titles are generated in this language and stored lines use it (subtitles removed from the
  // product, so this no longer drives any subtitle rendering). Additive + optional: old rows are NULL
  // and resolve to "en" via getDialogueLanguage(), keeping current behavior.
  dialogueLanguage String? @default("en")
  idea        String?  @db.Text
  // New flow (Stage 14 B): producer-chosen number of episodes for the season. Null = let the AI decide.
  episodeCount Int?
  // Stage 173 (task 1): AI-recommended number of episodes, computed from the approved synopsis right after
  // synopsis approval. Shown to the producer as the suggested value (they may keep it or override via
  // `episodeCount`). Additive + optional: legacy rows keep NULL and behave exactly as before.
  recommendedEpisodeCount Int?
  // Stage 210 (batched story generation): how many per-episode synopses have been generated so far for the
  // season story, generated in batches of STORY_EPISODE_BATCH (=3). Null = legacy/all-at-once flow (unchanged).
  storyEpisodesGenerated Int?
  // Stage 200 (3-step approval flow): the short "story idea" logline (2–3 sentences) — the FIRST
  // approval gate, generated before the synopsis. Additive + optional: legacy rows keep NULL and
  // skip straight to the synopsis step exactly as before.
  logline     String?  @db.Text
  loglineApproved Boolean @default(false)
  synopsis    String?  @db.Text
  synopsisApproved Boolean @default(false)
  // Stage 46A: approved SHORT synopsis (JSON {premise, episodes[{number, logline}]}) — mandatory outline for the season structure.
  shortSynopsis String? @db.Text
  // Stage 1 (dramaBible): the structured story bible (theme, tropes, protagonist/antagonist arcs, escalation
  // ladder, scheduled secrets, midpoint reversal, finale question, B-line, relationships) — generated FIRST,
  // the prose synopsis is derived from it, and it is threaded into every later prompt (season map / episode
  // outlines / scripts). Additive + optional: old projects keep NULL and behave exactly as before.
  dramaBible  Json?
  // Stage 1: the drama-bible prompt CONTRACT version that produced `dramaBible` (see DRAMA_BIBLE_PROMPT_VERSION).
  dramaBibleVersion String?
  charactersApproved Boolean @default(false)
  charactersLocked Boolean @default(false)
  structureApproved Boolean @default(false)
  isTest      Boolean  @default(false) // stage 40: «Тестовая серия» — a one-scene sandbox project (no season structure, references optional)
  // Stage 59: durable "new 4-step flow" marker. New projects set it true; legacy rows stay false (classic flow).
  // The wizard needs this because at stage=synopsis/early-structure charactersApproved is still false.
  newFlow     Boolean  @default(false)
  // Stage 104: the only media provider is WaveSpeed (columns kept for compatibility, always "wavespeed")
  imageProvider String @default("wavespeed")
  videoProvider String @default("wavespeed")
  // Stage 242 — project-level EDITABLE scene-prompt template. NULL = use DEFAULT_SCENE_PROMPT_TEMPLATE
  // (byte-for-byte the previous hard-coded structure). Applied to every scene's non-override prompt.
  scenePromptTemplate String? @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  characters  Character[]
  locations   Location[]
  artifacts   Artifact[]
  seasons     Season[]

  @@index([userId])
}

model Character {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String?  @db.Text
  role        String?
  personality String?  @db.Text
  appearance  String?  @db.Text
  promptOverride String? @db.Text // stage 46E: manual character prompt — when non-empty it replaces the appearance base for ALL reference shots; null = auto
  age         String?  // free-form ("34", "около 40")
  gender      String?  // Stage 125: "male" | "female" — single source of truth for the character's sex (scenario + reference generation); forces sex/age in the reference prompt so a role like "мать" never renders as a man. null = unknown (fallback heuristic from role/appearance)
  firstAppearance String? @db.Text // where/how the character first appears in the season
  status      String   @default("draft") // draft, approved, references_ready
  imageFront  String?  // cloud_storage_path or placeholder url
  imageProfile String? // cloud_storage_path or placeholder url
  imageFull   String?  // cloud_storage_path or placeholder url
  imageExtra  String?  @db.Text // Stage 14 (E): JSON array of extra character angles (3/4 view, action pose) → 5 photos total
  imageFrontIsPublic  Boolean @default(true)
  imageProfileIsPublic Boolean @default(true)
  imageFullIsPublic   Boolean @default(true)
  isLocked    Boolean  @default(false)
  refLocked   Boolean  @default(false) // Stage 22: reference finalized ("save forever" or after one prompt edit) — no further edits allowed
  userRefs    String?  @db.Text // Stage 75: user-uploaded photo references (JSON array of public S3 URLs, max 4) fed as image_input to every character reference generation
  faceImageUrl String? @db.Text // Optional single "face photo" uploaded at character creation — a public S3 URL fed FIRST (before userRefs/anchors) into every character reference generation so the user can cast their own face in the lead role. null = none
  // Stage 3 (extended cast): MAIN / SUPPORTING / MINOR / CROWD; groupSize only for CROWD groups.
  tier        String   @default("MAIN")
  groupSize   Int?
  // Stage 2 (Stage171) — character depth seeded from the dramaBible. All OPTIONAL/additive; legacy rows keep working.
  voiceProfile   String? @db.Text // casting / voice description (timbre, accent, pace)
  speechTics     Json?           // 2-3 short verbal habits (string[])
  secretsKnown   Json?           // which dramaBible secrets this character knows (string[])
  relationshipsTo Json?          // map charName -> relationship-dynamic (from the bible relationships)
  castPromptVersion String?      // lib/prompts/cast.ts version that produced these depth fields
  prevSnapshot Json?   // stage 60: one previous version for one-step undo
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenes      SceneCharacter[]
  episodes    EpisodeCharacter[]

  @@index([projectId])
}

model Season {
  id          String   @id @default(cuid())
  projectId   String
  number      Int
  title       String?
  logline     String?  @db.Text // stage 2: season arc summary
  fullStory   String?  @db.Text // stage 12: whole detailed season story with explicit episode markers (canon for the whole season)
  userPlotUploaded Boolean @default(false) // stage 155: fullStory holds an author-uploaded plot file (drives episode scripts) rather than the auto-built plot
  status      String   @default("draft") // draft, approved
  premise     String?  @db.Text // stage 46C: season synopsis / short-synopsis JSON for seasons > 1
  previousSeasonId String? // stage 46C: the season this one continues
  episodeCount Int?    // stage 46C: planned episode count
  direction   String?  @db.Text // stage 46C: author's comment for this season
  // Stage 3 (task Stage 3 seasonMap): the validated per-episode SEASON MAP (one cell per episode:
  // beatType / escalationStep / secretRevealed? / cliffhangerType / timeSkipBefore / locations / activeThreads).
  // Optional/additive so older seasons keep working; when null the episode outlines are built exactly as before.
  seasonMap        Json?    // Stage 3: SeasonMapCell[] constraining each episode outline
  seasonMapVersion String?  // Stage 3: the season-map prompt version this map was generated with
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  episodes    Episode[]
  seasonStates SeasonState[]

  @@index([projectId])
}

// Stage 4 (task Stage 4): the live world-state of a season. After each episode is approved (moved to
// scene breakdown) a separate LLM call updates this state; the next episode's prompt is built FROM this
// state instead of the old ~1200-char continuity text tail. Optional/additive — when absent (episode 1 or
// old seasons) the pipeline falls back to the previous behaviour, so this is fully backward compatible.
model SeasonState {
  id                    String   @id @default(cuid())
  seasonId              String
  reflectsEpisodeNumber Int?     // the episode number whose approval produced this state (null = seeded)
  state                 Json     // SeasonStateData: characters/props/openThreads/plantedSetups/revealedToAudience/lastSceneEndState
  version               String   // the season-state prompt version this record was produced with
  // P10 (additive): true when an EARLIER episode was reworked after this state was written, so this state
  // reflects a now-outdated continuity chain and must be regenerated. Default false = fresh.
  stale                 Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  season                Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@index([seasonId])
}

model Episode {
  id            String   @id @default(cuid())
  seasonId      String
  number        Int
  title         String
  description   String?  @db.Text
  cliffhanger   String?  @db.Text
  // Stage 2 fields (additive): logline, location, full script text, status.
  logline       String?  @db.Text
  locationName  String?
  locationDesc  String?  @db.Text
  locationId    String?  // stage 3: bound project Location (reference image)
  // Stage 173 (task 2): the episode PLOT — a prose beat-sheet (events, characters, locations/sub-locations,
  // scene order) generated on the episode-plot page BEFORE the script. Plots are generated sequentially on
  // demand (episode N's plot enables episode N+1's plot). It is the AUTHORITATIVE BASIS for the script
  // (task 3). Additive + optional: legacy rows keep NULL and are unaffected.
  plot          String?  @db.Text
  plotStatus    String?  // null/"pending" = not generated yet | "generating" | "ready" — drives the plot page UI
  script        String?  @db.Text
  arcRole       String?  // stage 2: завязка / развитие / поворот / финал
  status        String   @default("draft") // draft, script_ready, scenes_ready, approved, assembled
  videoUrl      String?  // assembled episode video URL
  videoIsPublic Boolean  @default(false)
  assembleQuality String? // Stage 46B: production quality of the last assembly ("480p" | "720p" | "1080p")
  assembleFps   Int?     // Stage 46B: frame rate of the last assembly (30 | 60)
  chainMode     String   @default("chain") // stage 40 / stage 98: scene generation order — "chain" (DEFAULT since stage 98: one after another, the actual last frame is described and fed to the next scene) | "parallel" (all at once, scripted end-state hand-off). Existing rows keep their stored value.
  chainRunActive Boolean @default(false) // stage 40: a «Сгенерировать все» chain run is in progress — the worker starts the next pending scene after each finished one
  chainRunNote  String?  @db.Text // stage 40: why the last chain run stopped («Цепочка остановлена на сцене N: …»), null while running / after a clean finish
  propRegistry  String?  @db.Text // stage 54: cached JSON snapshot of the episode PROP REGISTRY ({hash, props:[{id,name,description}]}) — auto-extracted from the script, re-built when the hash changes, substituted VERBATIM into each scene's CLOTHING & PROPS section. DATA cache, not a behaviour toggle.
  // Stage 127: production mode chosen AFTER the story is built.
  //   null / "SCENES"  = classic 9-scene pipeline (reangle/region-plate continuity, text-to-video, keyframe/i2v BAN in force).
  //   "STORYBOARD"     = 12-15 keyframe boards; each board frame is a 9:16 still animated into a 3-6s clip via image-to-video,
  //                      clips stitched into one ~90s cut. The keyframe/i2v ban is LIFTED only for this mode.
  // Legacy rows have null → treated as SCENES (fallback), so existing episodes are unaffected.
  mode          String?
  // Generation unit of this episode (additive, backward-compatible). Existing rows default to "scene".
  //   "scene" (DEFAULT) — 1 scene = 1 prompt = 1 clip (up to ~10 s); episode assembly concatenates per-scene clips.
  //   "shots"           — «Шоты» mode: the SHOT is the atomic unit (Stage 167 pipeline); assembly concatenates per-shot clips.
  generationMode String  @default("scene")
  // Stage 166 (additive): the 1-based index of the episode's single emotional-peak scene, and the episode-script
  // prompt version this script was generated with. Both nullable so existing rows are unaffected.
  peakSceneIndex Int?
  promptVersion  String?
  // Stage 174 (additive): ASSET-GATHERING gate state for STORYBOARD mode. null = no gate (normal). "assets"
  // = a board split was requested but is waiting for the episode's missing character/location references to
  // generate; the advance-chains cron starts the split automatically once they are all ready, then clears it.
  // Nullable/backward-compatible — legacy rows keep NULL and behave exactly as before.
  boardGate      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  season        Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  location      Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  scenes        Scene[]
  characters    EpisodeCharacter[]
  artifacts     EpisodeArtifact[]
  boards        Board[]

  @@index([seasonId])
}

/// Stage 127: a single keyframe board of a STORYBOARD-mode episode. Each board is ONE shot change —
/// one action beat OR one pair of dialogue lines. Its frame is a 9:16 reference still (Seedream) that is
/// animated into a 3-6s clip via image-to-video (the board frame is the clip START frame). 12-15 boards
/// per episode, stitched into one ~90s cut. Only used when Episode.mode = "STORYBOARD".
model Board {
  id               String   @id @default(cuid())
  episodeId        String
  index            Int      // 0-based board order within the episode
  actionOrDialogue String   @db.Text // the single action beat OR the dialogue pair this board depicts (story language)
  motionEn         String?  @db.Text // English image-to-video MOTION prompt (what moves during the 3-6s animation)
  // Stage 131: bind the board to its location ZONE so every board of a location shares one geometry authority
  // (master/region plate), the same stabilization SCENES uses (Stage 122). All nullable / additive; legacy
  // boards (null) fall back to the episode Location master plate. STORYBOARD only — SCENES is untouched.
  region           String?  @db.Text // project-language zone/corner of the location this board plays in (reuse identical wording for the same corner)
  regionKey        String?  // normalized cache key of `region` (deriveRegionKey) — resolves a cached region plate when one exists
  plateUrl         String?  // the geometry-authority plate actually attached to this board's frame (region plate, else location master)
  // Stage 142: SCENE ANCHOR FRAME — the first rendered board of the scene, attached as an image reference to every
  // later board of the same scene so the dressed set (desk, props) keeps its geometry. Null on the anchor board itself.
  anchorUrl        String?  // imageUrl of the scene anchor board actually attached to this frame's image_input
  anchorBoardId    String?  // Board.id of that anchor board
  directionJson    String?  @db.Text // Stage 132: validated Storyboard-only speech ledger, camera mode and dialogue shot plan; null for legacy boards
  // Stage 220 (PER-SCENE storyboard): each Scene now yields EXACTLY two boards — a start frame (boardRole="start")
  // and an end frame (boardRole="end") — plus one start→end i2v clip stored on the start board. All nullable /
  // additive; legacy boards (the old ~50 discrete boards) keep NULL and load/render exactly as before.
  sceneId          String?  // Scene.id this board belongs to (null for legacy boards)
  boardRole        String?  // "start" | "end" — which frame of the scene this board is (null for legacy boards)
  castInFrame      Json?    // { onScreen[], entering[], exiting[], startFrame, endFrame, motion, durationSec, dialogue[], shotType, inFrame[], focus } — per-scene shot plan
  // Stage 235 (additive): the chosen SHOT SCALE for this board (ShotSize string, e.g. "CLOSE-UP", "TWO-SHOT",
  // "WIDE ESTABLISHING") so generated boards rotate cinematic coverage board-to-board instead of a count-based
  // single size. Drives the render workers + a read-only UI badge. Nullable; legacy boards keep NULL.
  shotType         String?  // per-board shot scale (rotating storyboard coverage); null for legacy boards
  imagePrompt      String?  @db.Text // English Seedream FRAME prompt used to render the board still (9:16)
  // Stage 233 (additive): USER-EDITED prompt overrides. When non-null/non-empty the render workers use the text
  // VERBATIM instead of rebuilding it — the manual edit sticks across re-renders. Null/empty = fall back to the
  // auto-composed prompt (the default behaviour). Nullable so all legacy boards are unaffected.
  imagePromptOverride  String? @db.Text // user-edited FRAME prompt (overrides the auto-built imagePrompt when set)
  motionPromptOverride String? @db.Text // user-edited ANIMATION prompt (overrides the auto-built i2v motion prompt when set)
  // Group B (transparency): the ACTUAL animate prompt + the ACTUAL reference images passed to each model, plus the
  // fixed frame seed. All nullable / additive; legacy boards remain NULL. STORYBOARD only.
  motionPromptEn   String?  @db.Text // English image-to-video prompt actually sent to Seedance (composed animate prompt)
  frameRefs        Json?    // ordered references passed to the FRAME model: [{ index, url, kind, label(ru) }]
  animateRefs      Json?    // ordered references passed to the i2v model (start frame only): [{ index, url, kind, label(ru) }]
  frameSeed        Int?     // fixed seed forwarded to the frame model for reproducible re-renders (best-effort)
  imageUrl         String?  // S3 URL of the rendered board frame (9:16) — the clip's START frame
  videoUrl         String?  // S3 URL of the animated 3-6s clip (image-to-video)
  durationSec      Int?     // planned clip length in seconds (clamped to the i2v-supported 4-6s window)
  status           String   @default("pending") // pending | frame_generating | frame_ready | animating | done | error
  error            String?  @db.Text // last frame/animation error
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  episode          Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([episodeId, index])
  @@index([episodeId])
}

/// Stage 3: key locations of a project — photoreal reference images used by Seedance alongside characters.
model Location {
  id           String   @id @default(cuid())
  projectId    String
  name         String
  description  String?  @db.Text // project-language description shown in UI
  visualPrompt String?  @db.Text // English visual prompt for the reference image (no people)
  visualPromptAuto String? @db.Text // stage 46E: the LLM-written visual prompt as first produced — «reset to auto» restores it; null for legacy rows
  setInventory     String? @db.Text // stage 113: full physical set inventory ("object — placement" per line) written at idea stage; null for legacy rows
  regionPlates String?  @db.Text // stage 122: JSON cache { regionKey: plateUrl } — pre-generated region plates (Seedream edits of the master layout) reused across scenes in the same region of this location; null for legacy rows
  subLocationRefs String? @db.Text // JSON cache { normalizedSubLocation: s3Url } — one generated 9:16 angle reference per unique sub-location (spot) within this location, reused across every scene set at that spot; null for legacy rows
  imageUrl     String?  // PNG reference — wide establishing angle
  imageReverse String?  // same place, reverse angle (generated from imageUrl as reference → identical light)
  imageDetail  String?  // same place, medium/detail angle
  imageExtra   String?  @db.Text // JSON array of extra angle/shot URLs generated on demand
  refLocked    Boolean  @default(false) // Stage 22: reference finalized ("save forever" or after one prompt edit) — no further edits allowed
  detailLevel  String?  // LLM-set required visual detail level: "low" | "medium" | "high" → number of reference frames (4/6/9); null = legacy (heuristic fallback)
  dramaticFunction String? @db.Text // Stage 2 (Stage171) — why this location matters to the drama (one sentence); OPTIONAL/additive, null for legacy rows
  prevSnapshot Json?    // stage 60: one previous version for one-step undo
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  episodes     Episode[]
  scenes       Scene[]  @relation("SceneLocation") // Stage 162: scenes bound to this location (derived per-episode from the script)

  @@index([projectId])
}

/// Stage 2: which characters take part in an episode (additive join table).
model EpisodeCharacter {
  id          String   @id @default(cuid())
  episodeId   String
  characterId String
  createdAt   DateTime @default(now())

  episode     Episode   @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([episodeId, characterId])
  @@index([characterId])
}

/// Stage 14 (E): important objects / props used in the story — photoreal reference frames
/// (2 per artifact) that Seedance keeps consistent across shots. Project-scoped, bound to
/// the episodes that use them via EpisodeArtifact.
model Artifact {
  id           String   @id @default(cuid())
  projectId    String
  name         String
  description  String?  @db.Text // project-language description shown in UI
  visualPrompt String?  @db.Text // English visual prompt for the reference frames (object only)
  imageUrl     String?  // primary frame
  imageExtra   String?  @db.Text // JSON array of the remaining frame URLs (→ 2 frames total with imageUrl)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  episodes     EpisodeArtifact[]

  @@index([projectId])
}

/// Stage 14 (E): which artifacts appear in an episode (additive join table).
model EpisodeArtifact {
  id          String   @id @default(cuid())
  episodeId   String
  artifactId  String
  createdAt   DateTime @default(now())

  episode     Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  artifact    Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@unique([episodeId, artifactId])
  @@index([artifactId])
}

model Scene {
  id            String   @id @default(cuid())
  episodeId     String
  number        Int
  // Short human-readable scene title (2-6 words, no location dump) captured from the script writer.
  // Additive & nullable — legacy / manual scripts leave it null and the UI falls back to "Scene N".
  title         String?
  dialogue      String?  @db.Text
  dialogueEn    String?  @db.Text // stage 4: English lines actually spoken by Seedance (dialogue = story-language text for UI display)
  // DEPRECATED (subtitles removed from the product): no longer read or written by product code.
  // Column kept for historical rows only — additive schema policy, do NOT drop or migrate.
  subtitled     Boolean  @default(false)
  locationDesc  String?  @db.Text
  videoPrompt   String?  @db.Text
  videoUrl      String?  // generated scene video URL (Seedance native audio)
  audioUrl      String?  // legacy separate audio for the scene dialogue
  lastFrameUrl  String?  // last frame of this scene's video (S3) — fed as first-frame of the next scene for one-take continuity
  videoIsPublic Boolean  @default(false)
  language      String   @default("en") // spoken language for native audio: "en" or "ru"
  shotType      String?  // stage 2: shot type label from the season script
  action        String?  @db.Text // stage 2: readable action description of the shot
  durationSec   Int?     // stage 2: planned duration (10–15s)
  presence      String?  @db.Text // stage 11: continuity — who is present and where at the START of the scene (follows from the previous scene)
  entrances     String?  @db.Text // stage 11: continuity — who enters/leaves inside the scene and how (shown on screen)
  continuesFrom String?  // stage 11: continuity link to the previous scene: same-location-continuation | character-moves | location-change | new-sequence
  sceneKind     String?  @default("dialogue") // stage 12: "narration" = off-screen voice-over scene (b-roll), "dialogue"/null = normal on-camera scene
  voiceover     String?  @db.Text // stage 12: ENGLISH off-screen narration voiced by the model (backstory/catch-up), used only for narration scenes
  voiceoverLocal String? @db.Text // stage 12: the same narration translated into the story language for the UI
  status        String   @default("pending") // pending, generating, generated, accepted
  videoModel    String?  // chosen video model / provider for this scene: always "seedance" (Seedance 2.5; Stage 63 removed the alternative model option) — persisted per generated scene
  promptOverride String? @db.Text // stage 31: manual per-scene final-prompt override — when non-empty it replaces the auto-assembled prompt TEXT verbatim (image/reference chaining is unaffected); null = use auto prompt
  skipReferences Boolean @default(false) // stage 33/36: submit this scene WITHOUT any reference images (text-only), previous-scene frame included
  skipPreviousFrame Boolean @default(false) // stage 37: keep character/location references but do NOT send the previous scene's last frame (moderation trigger)
  startState    String?  @db.Text // stage 41: SCRIPTED start state of the scene's FIRST frame (English, from the screenwriter) — equals the previous scene's endState unless the scene starts a new sequence; opens the prompt as OPENING STATE
  endState      String?  @db.Text // stage 40: SCRIPTED end state of the scene's final frame (English, from the screenwriter) — the next scene's OPENING STATE in parallel mode
  endStateActual String? @db.Text // stage 40: ACTUAL end state described by a vision model from the generated last frame (chain mode) — wins over endState for the next scene
  lookCache     String?  @db.Text // stage 46B-1: JSON {hash, videoPrompt, startState, endState, openingState} — scene text rewritten to the CURRENT character look
  lookStale     Boolean  @default(false) // stage 46B-1: a linked character's appearance changed after this scene's video was rendered
  prevSnapshot  Json?    // stage 60: one previous version for one-step undo
  // Stage 104: keyframe-driven scenes — a Seedream still (opening frame of the shot) that seeds Seedance image-to-video
  keyframeUrl    String?          // S3 URL of the generated keyframe (9:16 jpeg)
  keyframePrompt String? @db.Text // exact Seedream edit prompt used for the keyframe (shown in the Scene Script modal)
  keyframeStatus String?          // pending | running | done | error
  keyframeError  String? @db.Text // last keyframe error (also set when the video fell back to text-to-video)
  // Stage 122: scene region plate — a pre-generated environment plate (Seedream edit of the master layout) of the
  // exact part of the location this scene happens in, sent as the PRIMARY geometry/background reference into the
  // scene's video clips. NOT a keyframe (no imposed start pose, never a first frame); the last-frame re-angle is
  // kept only for people/motion continuity. Null for legacy scenes → they fall back to the master plates (no auto-migration).
  regionKey      String?          // normalized cache key of the region (locationId + regionKey → shared plate)
  regionDesc     String? @db.Text // English description of WHICH part / vantage of the location this scene occupies (drives the plate edit)
  regionPlateUrl String?          // S3 URL of the pre-generated region plate for this scene
  // Sub-location: a short, stable spot/angle key WITHIN the scene's location (e.g. "by the tall window",
  // "at the front door"), parsed from the script's machine-readable "subLocation" JSON field (season.ts S16).
  // Distinct from regionDesc (Seedream plate geometry) — this drives a single reusable 9:16 angle reference per
  // unique sub-location. Null/"" = no distinct spot → fall back to the base location reference (additive, nullable).
  subLocation   String?  @db.Text
  locationId    String?  // Stage 162: the Location this scene was bound to (derived per-episode from the finished script); null = fall back to the episode location
  promptBlocks  Json?    // Stage 165: the block-assembled prompt for debugging { version, prompt, blocks{...}, cameraMove } (null on legacy rows / before first assembly)
  promptVersion String?  // Stage 165: PROMPT_VERSION that produced promptBlocks (traces a stored prompt back to its block rules)
  // Stage 167 (task Stage 5+6 replacement): a scene is now built as a ladder of SHOTS. Both additive & nullable so
  // legacy scenes (no ladder / no shots) still load and play through the classic scene pipeline unchanged.
  escalationBeats Json?  // Stage 167: ordered JSON array of 5-7 escalation steps for this scene (verbal → physicalLight → symbolic(keyProp) → physicalHeavy → statusReveal → thirdForce). null on legacy scenes.
  keyProp         String? // Stage 167: the single key prop the scene's symbolic escalation step turns on. null on legacy scenes.
  // P7 (additive): true when the approved Episode.script changed after this scene was derived from it, so the
  // scene (and its shots) are outdated and must be rebuilt. Default false = fresh; reset to false on rebuild.
  stale           Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  episode       Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  location      Location? @relation("SceneLocation", fields: [locationId], references: [id], onDelete: SetNull)
  characters    SceneCharacter[]
  shots         Shot[]   // Stage 167: the ordered shots this scene is chain-generated from (empty for legacy scenes)

  @@index([episodeId])
  @@index([locationId])
}

/// Stage 167 (task Stage 5+6 replacement): the SHOT — the ATOMIC unit of generation, one level below the Scene.
/// An episode is 60-90 s of 15-30 shots of 1.5-4 s each, planned from the approved scene/episode script. Each shot
/// is tied to ONE escalation step of its scene and is chain-generated (earliest ungenerated shot first, strictly
/// sequential). All fields beyond the identity/order are nullable / additive so nothing here is required to load an
/// old scene. Mirrors how Scene tracks generation (videoUrl / lastFrameUrl / status) so shots stitch like scenes.
model Shot {
  id             String   @id @default(cuid())
  sceneId        String
  index          Int      // 0-based order of the shot WITHIN its scene
  shotType       String   @default("dialogue") // dialogue | reaction | insert | action | establishing
  size           String?  // CU | MCU | MS | WS (framing scale)
  duration       Float?   // planned clip length in seconds (1.5-4; a reaction shot is 0.8-1.5)
  speakerId      String?  // Character.id of the speaker (dialogue shots)
  line           String?  @db.Text // the spoken line (English), when the shot has one
  // DEPRECATED (subtitles removed from the product): never read or written by product code.
  // Column kept for historical rows only — additive schema policy, do NOT drop or migrate.
  lineTranslation String? @db.Text
  reactionOfId   String?  // Character.id whose reaction this shot shows (reaction shots)
  escalationBeat String?  @db.Text // the scene escalation-ladder step this shot dramatizes
  postFx         String   @default("none") // slowmo | punchZoom | none — applied at assembly time
  matchCutIn     String?  @db.Text // 1-2 phrases: pose / gaze / prop carried IN from the previous shot
  matchCutOut    String?  @db.Text // 1-2 phrases: pose / gaze / prop carried OUT to the next shot
  prompt         String?  @db.Text // the assembled video-model prompt (blocks joined)
  promptBlocks   Json?    // the individual assembled prompt blocks { version, blocks{...} }
  promptVersion  String?  // SHOT_PROMPT_VERSION that produced prompt / promptBlocks
  videoUrl       String?  // generated shot clip URL (mirrors Scene.videoUrl)
  lastFrameUrl   String?  // last frame of this shot's clip (fed to the next shot for continuity, mirrors Scene.lastFrameUrl)
  status         String   @default("pending") // pending | generating | generated | accepted | error
  error          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  scene          Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@unique([sceneId, index])
  @@index([sceneId])
}

model SceneCharacter {
  id          String    @id @default(cuid())
  sceneId     String
  characterId String

  scene       Scene     @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([sceneId, characterId])
}

model CreditTransaction {
  id          String   @id @default(cuid())
  userId      String
  amount      Int      // positive = added, negative = spent
  description String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Payment {
  id             String   @id @default(cuid())
  orderReference String   @unique
  userId         String
  productId      String   // plan or credit-pack id
  productName    String
  amount         Float    // charged amount (UAH)
  currency       String   @default("UAH")
  credits        Int      // credits to grant on success
  kind           String   // "subscription" | "credits"
  tier           String?  // subscription tier when kind = subscription
  status         String   @default("pending") // pending, approved, declined, refunded, expired
  transactionStatus String?
  reasonCode     String?
  processed      Boolean  @default(false) // credits already granted (idempotency)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Background generation job (characters / video). Frontend polls GET /api/jobs/[id].
model GenerationJob {
  id          String   @id @default(cuid())
  type        String   // "characters" | "video" | "image"
  status      String   @default("pending") // "pending" | "processing" | "completed" | "failed"
  progress    Int      @default(0) // 0-100
  message     String?  // current step description
  projectId   String
  characterId String?  // for character jobs
  sceneId     String?  // for video/scene jobs
  resultData  String?  @db.Text // JSON string
  error       String?  @db.Text
  cancelRequested Boolean @default(false) // stage 11: author asked to stop — workers check it and mark the job "canceled"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId, status])
  @@index([sceneId])
}

// Stage 7 (task Stage 7 — critic-driven generation) — diagnostic log of generation outcomes.
// Additive + optional; a row is written when a generation exhausts retries or the critic never accepts
// (and optionally on accepted results). Old records / flows are unaffected — nothing reads this to run.
model GenerationLog {
  id            String   @id @default(cuid())
  projectId     String?
  seasonId      String?
  episodeId     String?
  kind          String   // "synopsis" | "seasonMap" | "episodeScript" | "dramaBible" | ...
  model         String
  promptVersion String
  attempts      Int      @default(0)
  finalScore    Float?
  accepted      Boolean  @default(false)
  notes         Json?
  error         String?  @db.Text
  createdAt     DateTime @default(now())

  @@index([projectId])
  @@index([kind])
}

// Stage 234: "Manual mode" — standalone photo / video generations outside of any project (/manual).
// kind: "photo" | "video"; mode: "t2i" | "i2i" | "t2v" | "i2v"; status: pending | processing | completed | failed.
model ManualGeneration {
  id             String   @id @default(cuid())
  userId         String
  kind           String
  model          String
  mode           String
  prompt         String   @db.Text
  referenceUrls  Json?
  sourceImageUrl String?  @db.Text
  resultUrl      String?  @db.Text
  status         String   @default("pending")
  jobId          String?
  cost           Int      @default(0)
  error          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Stage 234h: "Location Generator" (/manual) — a saved location entity with four wall labels and four
// generated 9:16 plates (front / back / left / right). Reusable as a reference in the video-prompt builder.
model ManualLocation {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String   @db.Text
  frontLabel  String
  backLabel   String
  leftLabel   String
  rightLabel  String
  frontUrl    String?  @db.Text
  backUrl     String?  @db.Text
  leftUrl     String?  @db.Text
  rightUrl    String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
