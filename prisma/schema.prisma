generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  credits       Int       @default(100)
  subscriptionTier String? @default("free")
  subscriptionExpiresAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  projects      Project[]
  creditTransactions CreditTransaction[]
  payments      Payment[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  name        String
  tier        String   @default("minimum") // minimum, medium, maximum
  stage       String   @default("synopsis") // synopsis, characters, structure, scenes
  synopsis    String?  @db.Text
  synopsisApproved Boolean @default(false)
  charactersLocked Boolean @default(false)
  structureApproved Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  characters  Character[]
  seasons     Season[]

  @@index([userId])
}

model Character {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String?  @db.Text
  role        String?
  personality String?  @db.Text
  appearance  String?  @db.Text
  imageFront  String?  // cloud_storage_path or placeholder url
  imageProfile String? // cloud_storage_path or placeholder url
  imageFull   String?  // cloud_storage_path or placeholder url
  imageFrontIsPublic  Boolean @default(true)
  imageProfileIsPublic Boolean @default(true)
  imageFullIsPublic   Boolean @default(true)
  isLocked    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenes      SceneCharacter[]

  @@index([projectId])
}

model Season {
  id          String   @id @default(cuid())
  projectId   String
  number      Int
  title       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  episodes    Episode[]

  @@index([projectId])
}

model Episode {
  id            String   @id @default(cuid())
  seasonId      String
  number        Int
  title         String
  description   String?  @db.Text
  cliffhanger   String?  @db.Text
  videoUrl      String?  // assembled episode video URL
  videoIsPublic Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  season        Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  scenes        Scene[]

  @@index([seasonId])
}

model Scene {
  id            String   @id @default(cuid())
  episodeId     String
  number        Int
  dialogue      String?  @db.Text
  locationDesc  String?  @db.Text
  videoPrompt   String?  @db.Text
  videoUrl      String?  // generated scene video URL (silent, Seedance)
  audioUrl      String?  // ElevenLabs voiceover for the scene dialogue
  videoIsPublic Boolean  @default(false)
  language      String   @default("en") // spoken language for native audio: "en" or "ru"
  status        String   @default("pending") // pending, generating, generated, accepted
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  episode       Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  characters    SceneCharacter[]

  @@index([episodeId])
}

model SceneCharacter {
  id          String    @id @default(cuid())
  sceneId     String
  characterId String

  scene       Scene     @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([sceneId, characterId])
}

model CreditTransaction {
  id          String   @id @default(cuid())
  userId      String
  amount      Int      // positive = added, negative = spent
  description String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Payment {
  id             String   @id @default(cuid())
  orderReference String   @unique
  userId         String
  productId      String   // plan or credit-pack id
  productName    String
  amount         Float    // charged amount (UAH)
  currency       String   @default("UAH")
  credits        Int      // credits to grant on success
  kind           String   // "subscription" | "credits"
  tier           String?  // subscription tier when kind = subscription
  status         String   @default("pending") // pending, approved, declined, refunded, expired
  transactionStatus String?
  reasonCode     String?
  processed      Boolean  @default(false) // credits already granted (idempotency)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Background generation job (characters / video). Frontend polls GET /api/jobs/[id].
model GenerationJob {
  id          String   @id @default(cuid())
  type        String   // "characters" | "video" | "image"
  status      String   @default("pending") // "pending" | "processing" | "completed" | "failed"
  progress    Int      @default(0) // 0-100
  message     String?  // current step description
  projectId   String
  characterId String?  // for character jobs
  sceneId     String?  // for video/scene jobs
  resultData  String?  @db.Text // JSON string
  error       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId, status])
  @@index([sceneId])
}
